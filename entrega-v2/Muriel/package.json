{
  "name": "muriel-testes",
  "private": true,
  "version": "1.0.0",
  "description": "Testes de validação de produto do StockFlow (Vitest + oxlint)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "lint:modulo": "cd .. && node Muriel/node_modules/oxlint/bin/oxlint -c Muriel/.oxlintrc.json TCC-Claude/frontend/src/utils/productValidation.js Muriel/testes/validacao-produto.test.js Muriel/testes/validacao-produto-limites.test.js",
    "lint:projeto": "cd .. && node Muriel/node_modules/oxlint/bin/oxlint -c Muriel/.oxlintrc.json TCC-Claude/frontend/src"
  },
  "devDependencies": {
    "oxlint": "1.83.0",
    "vitest": "5.1.0"
  }
}
